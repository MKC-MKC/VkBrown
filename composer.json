{
    "name": "haikiri/vkbrown",
    "description": "VkBrown – VK Php SDK for Composer",
    "keywords": [
        "php",
        "api",
        "sdk",
        "bot",
        "vk",
        "vkbrown"
    ],
    "homepage": "https://github.com/MKC-MKC/VkBrown",
    "type": "library",
    "license": "proprietary",
    "autoload": {
        "psr-4": {
            "Haikiri\\VkBrown\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Haikiri\\VkBrown\\Tests\\": "tests/"
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true,
    "require": {
        "php": ">=8.2",
        "ext-json": "*",
        "ext-curl": "*",
        "guzzlehttp/guzzle": "^7.10"
    },
    "authors": [
        {
            "name": "Haikiri",
            "email": "haikiri@ya.ru",
            "homepage": "https://haikiri.t.me"
        }
    ],
    "require-dev": {
        "phpunit/phpunit": "^12.1"
    },
    "scripts": {
        "test": "vendor/bin/phpunit --colors=always tests",
        "test:debug": "vendor/bin/phpunit --colors=always --debug tests",
        "test:dox": "vendor/bin/phpunit --colors=always --display-deprecations --testdox tests"
    }
}
